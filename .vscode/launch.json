{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pyd: isa2gtfs",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "module": "isa2gtfs",
            "cwd": "${workspaceFolder}",
            "args": [
                "-i",
                "${input:input}",
                "-o",
                "${input:output}",
                "-c",
                "${input:config}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "input",
            "type": "promptString",
            "description": "Input ZIP file or directory",
            "default": "${workspaceFolder}/sampledata"
        },
        {
            "id": "output",
            "type": "promptString",
            "description": "Output ZIP file or directory",
            "default": "${workspaceFolder}/sampledata"
        },
        {
            "id": "config",
            "type": "promptString",
            "description": "Configuration YAML file",
            "default": "${workspaceFolder}/config.yaml"
        }
    ]
}